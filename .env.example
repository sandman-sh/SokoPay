# ==============================================================================
# SokoPay - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the required values.
# 
# Usage:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & RPC CONFIGURATION
# ------------------------------------------------------------------------------
# Active Network for SokoPay server:
# Options: "localhost" | "celo-sepolia" | "celo-mainnet"
ACTIVE_NETWORK=localhost

# Port for the Node.js Express server
PORT=3001

# Public Web / App URL (used for generating WhatsApp, Instagram & MiniPay deep links)
APP_URL=http://localhost:5173

# Celo RPC Endpoints (Default public endpoints use Celo Forno)
# You can also use QuickNode, Alchemy, or Infura RPC URLs.
CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# ------------------------------------------------------------------------------
# 2. CELO ERC-8021 ATTRIBUTION TAG
# ------------------------------------------------------------------------------
# Project attribution tag registered on celobuilders.xyz / Dune Analytics.
# Appended as a 32-byte suffix to transaction calldata for ecosystem attribution.
CELO_ATTRIBUTION_TAG=celo_sokopay1234

# ------------------------------------------------------------------------------
# 3. SMART CONTRACT ADDRESSES
# ------------------------------------------------------------------------------
# SokoEscrow contract address deployed on Celo Sepolia testnet
ESCROW_ADDRESS_SEPOLIA=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# SokoEscrow contract address deployed on Celo Mainnet
ESCROW_ADDRESS_MAINNET=0x8689F95860A33611bCa3A8AEd41Cc501298727AF

# SokoAgentOracle delivery attestation contract address
ORACLE_ADDRESS_MAINNET=0x99ac8364da2D532045e44958c9D8820C621C496a

# ------------------------------------------------------------------------------
# 4. OPENROUTER & GENERATIVE AI API
# ------------------------------------------------------------------------------
# OpenRouter Free AI Key (Directly using DeepSeek V4 Flash - 100% Free, 1M context)
# Obtain free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

# ------------------------------------------------------------------------------
# 5. SUPABASE POSTGRESQL DATABASE & STORAGE
# ------------------------------------------------------------------------------
# Used for real persistence of deals, merchant profiles, reputation scores, and carrier events.
# If omitted or unreachable, SokoPay falls back to local JSON cache in server/data/.
# Obtain at: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://ncfrzscpvxyftdlrbgzs.supabase.co
SUPABASE_ANON_KEY=sb_publishable_P9Af93HSz2fk6JOznfvAfg_sMcEQtq7

# ------------------------------------------------------------------------------
# 6. ETHEREUM / CELO PRIVATE KEYS (FOR DEPLOYMENT & DELEGATED AGENT SIGNING)
# ------------------------------------------------------------------------------
# PRIVATE_KEY is used by Hardhat scripts (deploy.cjs) for deploying contracts.
# WARNING: Do NOT commit real private keys to git!
PRIVATE_KEY=

# Optional dedicated role private keys for agent-delegated transactions (defaults to Hardhat test accounts #0 - #3)
# DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# BUYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# SELLER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# ARBITER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# In Vite, variables prefixed with VITE_ are exposed to the client application.
VITE_API_BASE=http://localhost:3001/api
